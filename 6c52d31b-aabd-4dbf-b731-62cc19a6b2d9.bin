                    <td>Need/offer, matching, acceptance</td>
                    <td><span class="checkmark">✓</span></td>
                </tr>
                <tr>
                    <td><strong>group</strong></td>
                    <td>7</td>
                    <td>Dunbar circles, peer mgmt</td>
                    <td><span class="checkmark">✓</span></td>
