    echo ""
    echo "Option A: SSH Key (Recommended)"
    echo "  - Ensure SSH key is added to GitHub account"
    echo "  - Run: git push -u origin main"
    echo ""
    echo "Option B: Personal Access Token (HTTPS)"
    echo "  1. Generate PAT at: https://github.com/settings/tokens"
    echo "  2. Run: git remote set-url origin https://[PAT]@github.com/P2P-60-24/p2p-60-24-evo.git"
    echo "  3. Run: git push -u origin main"
    echo ""
    echo "Option C: GitHub CLI"
    echo "  - Install: https://cli.github.com/"
    echo "  - Run: gh auth login"
    echo "  - Run: git push -u origin main"
    echo ""
    echo "Option D: Web UI Push"
    echo "  - Use GitHub's web interface to create commits"
    echo "  - Upload files via web UI (slower but works)"
    echo ""
    exit 1
}

echo ""
echo "✅ Push succeeded!"
echo ""

